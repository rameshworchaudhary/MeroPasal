[32m+[m[32m        ([m
[32m+[m[32m          isOwner(userId)[m
[32m+[m[32m          && request.resource.data.uid == resource.data.uid[m
[32m+[m[32m          && request.resource.data.role == resource.data.role[m
[32m+[m[32m        );[m
[32m+[m
[32m+[m[32m      // Only admin can delete users.[m
[32m+[m[32m      allow delete: if isAdmin();[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m
[32m+[m[32m    // =========================[m
[32m+[m[32m    // PRODUCTS[m
[32m+[m[32m    // =========================[m
[32m+[m
[32m+[m[32m    match /products/{productId} {[m
[32m+[m
[32m+[m[32m      // Products are public.[m
