[32m+[m
[32m+[m[32m    match /orders/{orderId} {[m
[32m+[m
[32m+[m[32m      // Customer can read own orders.[m
[32m+[m[32m      // Admin can read all orders.[m
[32m+[m[32m      allow read: if[m
[32m+[m[32m        isAdmin()[m
[32m+[m[32m        ||[m
[32m+[m[32m        ([m
[32m+[m[32m          isSignedIn()[m
