[32m+[m
[32m+[m[32m    match /banners/{bannerId} {[m
[32m+[m
[32m+[m[32m      // Public read.[m
[32m+[m[32m      allow read: if true;[m
[32m+[m
[32m+[m[32m      // Only admin can manage banners.[m
[32m+[m[32m      allow create, update, delete: if isAdmin();[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m
[32m+[m[32m    // =========================[m
