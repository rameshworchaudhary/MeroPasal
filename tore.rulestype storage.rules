[32m+[m[32m        ([m
[32m+[m[32m          isSignedIn()[m
[32m+[m[32m          && resource.data.userId == request.auth.uid[m
[32m+[m[32m        );[m
[32m+[m[32m    }[m
[32m+[m
[32m+[m
