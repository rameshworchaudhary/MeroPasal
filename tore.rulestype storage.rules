[32m+[m[32m        && request.resource.data.paymentStatus == "pending";[m
[32m+[m
[32m+[m[32m      // Only admin can update orders.[m
[32m+[m[32m      //[m
[32m+[m[32m      // This protects:[m
[32m+[m[32m      // - total[m
[32m+[m[32m      // - payment status[m
[32m+[m[32m      // - payment transaction ID[m
[32m+[m[32m      // - order ownership[m
[32m+[m[32m      // - order items[m
[32m+[m[32m      allow update: if isAdmin();[m
[32m+[m
[32m+[m[32m      // Only admin can delete orders.[m
[32m+[m[32m      allow delete: if isAdmin();[m
