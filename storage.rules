rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ==========================================
    // HELPER FUNCTIONS
    // ==========================================

    function isSignedIn() {
      return request.auth != null;
    }

    function getUserRole() {
      return firestore.exists(/databases/(default)/documents/users/$(request.auth.uid))
        ? firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
        : null;
    }

    function isAdmin() {
      return isSignedIn() && getUserRole() == "admin";
    }

    function isSeller() {
      return isSignedIn() && getUserRole() == "seller";
    }

    function isValidImage() {
      return request.resource != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches("image/.*");
    }

    // ==========================================
    // PRODUCT IMAGES
    // ==========================================
    match /products/{allPaths=**} {
      // Anyone can view product images
      allow read: if true;

      // Admin or sellers can upload and update product images (<10MB images)
      allow create, update: if (isAdmin() || isSeller()) && isValidImage();

      // Admin or sellers can delete product images (request.resource is not checked on delete)
      allow delete: if isAdmin() || isSeller();
    }

    // ==========================================
    // CATEGORY IMAGES
    // ==========================================
    match /categories/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // ==========================================
    // BANNER IMAGES
    // ==========================================
    match /banners/{allPaths=**} {
      allow read: if true;
      allow create, update: if isAdmin() && isValidImage();
      allow delete: if isAdmin();
    }

    // ==========================================
    // REVIEW IMAGES
    // ==========================================
    match /reviews/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidImage();
      allow delete: if isAdmin() || isSignedIn();
    }

    // ==========================================
    // USER PROFILE AVATARS
    // ==========================================
    match /avatars/{allPaths=**} {
      allow read: if true;
      allow create, update: if isSignedIn() && isValidImage();
      allow delete: if isAdmin() || isSignedIn();
    }

    // ==========================================
    // DEFAULT DENY
    // ==========================================
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
